# ============================================
# MOMENTLY CO — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=momently-prod
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ---- Payments: Monobank ----
MONOBANK_TOKEN=your-monobank-token
MONOBANK_WEBHOOK_SECRET=your-webhook-secret

# ---- Payments: Stripe ----
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# ---- Email: Resend ----
RESEND_API_KEY=re_xxx
EMAIL_FROM=hello@momently.co

# ---- Claude API (for blog AI drafts) ----
ANTHROPIC_API_KEY=sk-ant-xxx

# ---- App ----
NEXT_PUBLIC_APP_URL=https://momently.co
NEXT_PUBLIC_DEFAULT_LOCALE=ua

# ---- Analytics ----
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
